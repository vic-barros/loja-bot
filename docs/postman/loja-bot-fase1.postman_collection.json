{
  "info": {
    "name": "Loja Bot — Fase 1 (Catálogo)",
    "description": "Testes da API do catálogo. Rode na ordem: os ids criados são guardados em variáveis da coleção e usados nos passos seguintes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "categoriaId", "value": "" },
    { "key": "produtoId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Categorias",
      "item": [
        {
          "name": "1.1 Cadastrar categoria Leggings",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 201 (criada) ou 409 (já existia de um teste anterior)', () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
              "});",
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    pm.test('Devolve o id e o nome', () => {",
              "        pm.expect(json.categoriaId).to.be.a('number');",
              "        pm.expect(json.nome).to.eql('Leggings');",
              "    });",
              "    pm.test('Cabeçalho Location aponta para a categoria', () => {",
              "        pm.expect(pm.response.headers.get('Location')).to.include('/categorias/' + json.categoriaId);",
              "    });",
              "    pm.collectionVariables.set('categoriaId', json.categoriaId);",
              "}"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Leggings\"\n}" },
            "url": { "raw": "{{baseUrl}}/categorias", "host": ["{{baseUrl}}"], "path": ["categorias"] }
          }
        },
        {
          "name": "1.2 Listar categorias",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const lista = pm.response.json();",
              "const leggings = lista.find(c => c.nome.toLowerCase() === 'leggings');",
              "pm.test('A lista contém Leggings', () => pm.expect(leggings).to.not.be.undefined);",
              "if (leggings) pm.collectionVariables.set('categoriaId', leggings.categoriaId);",
              "pm.test('Lista em ordem alfabética', () => {",
              "    const nomes = lista.map(c => c.nome);",
              "    pm.expect(nomes).to.eql([...nomes].sort((a, b) => a.localeCompare(b)));",
              "});"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categorias", "host": ["{{baseUrl}}"], "path": ["categorias"] }
          }
        },
        {
          "name": "1.3 ERRO: categoria repetida (outra caixa)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 409', () => pm.response.to.have.status(409));",
              "pm.test('Mensagem de categoria repetida', () => {",
              "    pm.expect(pm.response.json().detail).to.include('Já existe uma categoria');",
              "});"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"leggings\"\n}" },
            "url": { "raw": "{{baseUrl}}/categorias", "host": ["{{baseUrl}}"], "path": ["categorias"] }
          }
        }
      ]
    },
    {
      "name": "2. Produtos",
      "item": [
        {
          "name": "2.1 Cadastrar legging com 3 variações",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('produtoId', json.produtoId);",
              "pm.test('Produto nasce ativo e com o tecido padronizado', () => {",
              "    pm.expect(json.ativo).to.be.true;",
              "    pm.expect(json.tecido).to.eql('suplex');",
              "});",
              "pm.test('Três variações, com cor em minúsculas e tamanho em maiúsculas', () => {",
              "    pm.expect(json.variacoes).to.have.length(3);",
              "    json.variacoes.forEach(v => {",
              "        pm.expect(v.cor).to.eql(v.cor.toLowerCase());",
              "        pm.expect(v.tamanho).to.eql(v.tamanho.toUpperCase());",
              "    });",
              "});",
              "pm.test('SKUs gerados no formato LEG-<id>-COR-TAMANHO', () => {",
              "    const skus = json.variacoes.map(v => v.sku);",
              "    pm.expect(skus).to.include('LEG-' + json.produtoId + '-PRETA-M');",
              "    pm.expect(skus).to.include('LEG-' + json.produtoId + '-VERDE-AGUA-M');",
              "});"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categoriaId\": {{categoriaId}},\n  \"nome\": \"Legging Suplex Cintura Alta\",\n  \"descricao\": \"Compressão média, não fica transparente\",\n  \"tecido\": \"Suplex\",\n  \"preco\": 89.90,\n  \"variacoes\": [\n    { \"cor\": \"Preta\", \"tamanho\": \"M\", \"quantidadeEstoque\": 3 },\n    { \"cor\": \"Preta\", \"tamanho\": \"G\", \"quantidadeEstoque\": 0 },\n    { \"cor\": \"Verde Água\", \"tamanho\": \"m\", \"quantidadeEstoque\": 2 }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
          }
        },
        {
          "name": "2.2 Detalhes do produto",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Mostra também a variação sem estoque (visão da lojista)', () => {",
              "    const pretaG = json.variacoes.find(v => v.cor === 'preta' && v.tamanho === 'G');",
              "    pm.expect(pretaG).to.not.be.undefined;",
              "    pm.expect(pretaG.quantidadeEstoque).to.eql(0);",
              "});",
              "pm.test('Categoria vem pelo nome', () => pm.expect(json.categoria).to.eql('Leggings'));"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/produtos/{{produtoId}}", "host": ["{{baseUrl}}"], "path": ["produtos", "{{produtoId}}"] }
          }
        },
        {
          "name": "2.3 Adicionar foto",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('O produto agora tem a foto', () => {",
              "    pm.expect(pm.response.json().fotos).to.include('https://exemplo.com/legging-preta.jpg');",
              "});"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://exemplo.com/legging-preta.jpg\",\n  \"cor\": \"Preta\",\n  \"ordem\": 0\n}" },
            "url": { "raw": "{{baseUrl}}/produtos/{{produtoId}}/fotos", "host": ["{{baseUrl}}"], "path": ["produtos", "{{produtoId}}", "fotos"] }
          }
        }
      ]
    },
    {
      "name": "3. Busca (critério de pronto da fase 1)",
      "item": [
        {
          "name": "3.1 Legging preta M",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const lista = pm.response.json();",
              "pm.test('Encontra pelo menos uma peça', () => pm.expect(lista.length).to.be.above(0));",
              "pm.test('Só legging preta M com estoque', () => {",
              "    lista.forEach(v => {",
              "        pm.expect(v.categoria).to.eql('Leggings');",
              "        pm.expect(v.cor).to.eql('preta');",
              "        pm.expect(v.tamanho).to.eql('M');",
              "        pm.expect(v.quantidadeEstoque).to.be.above(0);",
              "    });",
              "});"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/produtos/busca?categoria=Leggings&cor=PRETA&tamanho=m",
              "host": ["{{baseUrl}}"], "path": ["produtos", "busca"],
              "query": [
                { "key": "categoria", "value": "Leggings" },
                { "key": "cor", "value": "PRETA" },
                { "key": "tamanho", "value": "m" }
              ]
            }
          }
        },
        {
          "name": "3.2 Sem estoque não aparece (preta G)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const pid = Number(pm.collectionVariables.get('produtoId'));",
              "pm.test('A preta G deste produto, com estoque 0, não aparece', () => {",
              "    const achou = pm.response.json().some(v => v.produtoId === pid);",
              "    pm.expect(achou).to.be.false;",
              "});"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/produtos/busca?cor=preta&tamanho=G",
              "host": ["{{baseUrl}}"], "path": ["produtos", "busca"],
              "query": [{ "key": "cor", "value": "preta" }, { "key": "tamanho", "value": "G" }]
            }
          }
        },
        {
          "name": "3.3 Sem filtros: tudo que está disponível",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Nenhuma peça sem estoque na lista', () => {",
              "    pm.response.json().forEach(v => pm.expect(v.quantidadeEstoque).to.be.above(0));",
              "});"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/produtos/busca", "host": ["{{baseUrl}}"], "path": ["produtos", "busca"] }
          }
        }
      ]
    },
    {
      "name": "4. Erros esperados",
      "item": [
        {
          "name": "4.1 Produto sem variações (400)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Aponta o campo variacoes', () => {",
              "    pm.expect(pm.response.json().campos).to.have.property('variacoes');",
              "});"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categoriaId\": {{categoriaId}},\n  \"nome\": \"Top sem variações\",\n  \"preco\": 59.90,\n  \"variacoes\": []\n}" },
            "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
          }
        },
        {
          "name": "4.2 Vários campos inválidos (400)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Lista os campos com erro, inclusive dentro das variações', () => {",
              "    const campos = Object.keys(pm.response.json().campos);",
              "    pm.expect(campos).to.include('nome');",
              "    pm.expect(campos).to.include('preco');",
              "    pm.expect(campos.some(c => c.startsWith('variacoes['))).to.be.true;",
              "});"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categoriaId\": {{categoriaId}},\n  \"nome\": \"\",\n  \"preco\": 0,\n  \"variacoes\": [\n    { \"cor\": \"\", \"tamanho\": \"M\", \"quantidadeEstoque\": -1 }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
          }
        },
        {
          "name": "4.3 Variação repetida no mesmo cadastro (409)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 409', () => pm.response.to.have.status(409));",
              "pm.test('Mensagem de variação repetida', () => {",
              "    pm.expect(pm.response.json().detail).to.include('Variação repetida');",
              "});"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categoriaId\": {{categoriaId}},\n  \"nome\": \"Legging repetida\",\n  \"preco\": 79.90,\n  \"variacoes\": [\n    { \"cor\": \"Preta\", \"tamanho\": \"M\", \"quantidadeEstoque\": 1 },\n    { \"cor\": \"preta \", \"tamanho\": \"m\", \"quantidadeEstoque\": 2 }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
          }
        },
        {
          "name": "4.4 Categoria inexistente (404)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Mensagem de categoria não encontrada', () => {",
              "    pm.expect(pm.response.json().detail).to.include('Categoria não encontrada');",
              "});"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categoriaId\": 999999,\n  \"nome\": \"Produto sem categoria\",\n  \"preco\": 49.90,\n  \"variacoes\": [\n    { \"cor\": \"Branca\", \"tamanho\": \"P\", \"quantidadeEstoque\": 1 }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
          }
        },
        {
          "name": "4.5 Produto inexistente (404)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/produtos/999999", "host": ["{{baseUrl}}"], "path": ["produtos", "999999"] }
          }
        },
        {
          "name": "4.6 Foto com http em vez de https (400)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Aponta o campo url', () => pm.expect(pm.response.json().campos).to.have.property('url'));"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"url\": \"http://exemplo.com/foto.jpg\",\n  \"ordem\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/produtos/{{produtoId}}/fotos", "host": ["{{baseUrl}}"], "path": ["produtos", "{{produtoId}}", "fotos"] }
          }
        },
        {
          "name": "4.7 Foto na mesma posição (409)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 409', () => pm.response.to.have.status(409));",
              "pm.test('Mensagem de posição ocupada', () => {",
              "    pm.expect(pm.response.json().detail).to.include('posição 0');",
              "});"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://exemplo.com/outra-foto.jpg\",\n  \"ordem\": 0\n}" },
            "url": { "raw": "{{baseUrl}}/produtos/{{produtoId}}/fotos", "host": ["{{baseUrl}}"], "path": ["produtos", "{{produtoId}}", "fotos"] }
          }
        }
      ]
    }
  ]
}
